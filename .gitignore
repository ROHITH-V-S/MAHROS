__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.venv/
venv/
node_modules/
package-lock.json

# Generated experiment output. Rebuild with:
#   python experiments/run_all.py 5 && python experiments/build_dashboard.py
results/*.json
results/*.html
results/*.png
!results/.gitkeep

# ...except the built dashboard, which is deployed rather than rebuilt.
# It is a single self-contained HTML file with the data embedded, and the
# sweep that produces it takes ~7 minutes -- far too slow to run in a
# platform build step. Committing it is what lets Vercel serve the results
# page and Render serve the /dashboard tab.
!results/dashboard.html
